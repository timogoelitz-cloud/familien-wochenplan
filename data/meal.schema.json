{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://familien-wochenplan.local/meal.schema.json",
  "title": "Familien-Wochenplan – Gericht-Import",
  "description": "Format, in dem Gerichte in die App importiert werden. Die App validiert jede Datei gegen diese Regeln und importiert im Fehlerfall NICHTS.",
  "type": "object",
  "required": ["meals"],
  "properties": {
    "format": { "const": "familien-wochenplan/meals" },
    "version": { "type": "integer", "minimum": 1 },
    "meals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/meal" }
    }
  },
  "$defs": {
    "unit": {
      "description": "Erlaubte Mengeneinheiten. Andere Werte werden abgelehnt.",
      "enum": ["g", "kg", "ml", "l", "Stk", "Pck", "Dose", "Glas", "Bund", "Scheibe", "EL", "TL", "Prise", "nach Bedarf"]
    },
    "quantity": {
      "type": "object",
      "required": ["amount", "unit"],
      "properties": {
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "$ref": "#/$defs/unit" }
      },
      "additionalProperties": false
    },
    "ingredient": {
      "type": "object",
      "required": ["name", "amount", "unit"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Produktname, z. B. \"Spaghetti\"." },
        "amount": { "type": "number", "minimum": 0, "description": "Menge für die typische Familienportion." },
        "unit": { "$ref": "#/$defs/unit" },
        "merchant": {
          "type": ["string", "null"],
          "description": "Name eines in der App angelegten Händlers. Unbekannte oder fehlende Namen werden zu \"Unklar\" – es wird nichts geraten."
        },
        "category": { "type": "string", "description": "Optionale Warengruppe, z. B. \"Trockenware\"." },
        "packageSize": {
          "oneOf": [{ "$ref": "#/$defs/quantity" }, { "type": "null" }],
          "description": "Übliche Packungsgröße. Muss dieselbe Dimension haben wie \"unit\" (Masse zu Masse, Volumen zu Volumen), sonst wird keine Packungszahl berechnet."
        },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "meal": {
      "type": "object",
      "required": ["name", "ingredients"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "recipe": { "type": "string", "description": "Zubereitung als Fließtext." },
        "image": { "type": ["string", "null"], "description": "Bild-URL oder data:-URL." },
        "servings": { "type": "number", "exclusiveMinimum": 0, "description": "Anzahl Portionen, auf die sich die Mengen beziehen." },
        "tags": { "type": "array", "items": { "type": "string" } },
        "active": { "type": "boolean", "default": true },
        "demo": { "type": "boolean", "description": "true kennzeichnet Testdaten, die NICHT aus echten Familienrezepten stammen." },
        "ingredients": { "type": "array", "items": { "$ref": "#/$defs/ingredient" } }
      },
      "additionalProperties": false
    }
  }
}
